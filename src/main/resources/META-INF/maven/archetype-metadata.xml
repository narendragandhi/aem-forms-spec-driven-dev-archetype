<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.0.0 http://maven.apache.org/xsd/archetype-descriptor-1.0.0.xsd" name="aem-forms-bmad-archetype"
    xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <requiredProperties>
        <requiredProperty key="formsVersion">
            <defaultValue>afaacs</defaultValue>
            <validationRegex>afaacs|6\.5</validationRegex>
        </requiredProperty>
        <requiredProperty key="appName">
            <defaultValue>MyFormsApp</defaultValue>
        </requiredProperty>
    </requiredProperties>
    <fileSets>
        <!-- Filtered text files (POMs, XMLs, Java, JS) -->
        <fileSet filtered="true">
            <directory></directory>
            <includes>
                <include>**/pom.xml</include>
                <include>**/*.xml</include>
            </includes>
            <excludes>
                <exclude>ui.frontend/node_modules/**</exclude>
                <exclude>ui.frontend.react.forms.af/node_modules/**</exclude>
                <!-- number-format patterns contain '##' which Velocity strips as comments -->
                <exclude>ui.content/src/main/content/jcr_root/conf/aem-forms-bmad-showcase/settings/wcm/policies/.content.xml</exclude>
            </excludes>
        </fileSet>
        <!-- unfiltered copy of the policies file excluded above (no placeholders in it) -->
        <fileSet filtered="false">
            <directory>ui.content/src/main/content/jcr_root/conf/aem-forms-bmad-showcase/settings/wcm/policies</directory>
            <includes>
                <include>.content.xml</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true">
            <directory>core/src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true">
            <directory>core/src/test/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <!-- ui.frontend.react.forms.af: filter files with ${appName}/${artifactId} placeholders;
             undefined Velocity refs (JS template literals) pass through unchanged.
             package-lock.json stays unfiltered — npm reconciles its name field on install. -->
        <fileSet filtered="true">
            <directory>ui.frontend.react.forms.af</directory>
            <includes>
                <include>src/App.jsx</include>
                <include>package.json</include>
                <include>index.html</include>
                <include>public/index.html</include>
            </includes>
        </fileSet>
        <!-- ui.frontend.react.forms.af: all other non-pom files (package.json, src/, public/, cypress/) -->
        <fileSet filtered="false">
            <directory>ui.frontend.react.forms.af</directory>
            <includes>
                <include>**/*</include>
            </includes>
            <excludes>
                <exclude>pom.xml</exclude>
                <exclude>src/App.jsx</exclude>
                <exclude>package.json</exclude>
                <exclude>index.html</exclude>
                <exclude>public/index.html</exclude>
                <exclude>node_modules/**</exclude>
                <exclude>**/node_modules/**</exclude>
            </excludes>
        </fileSet>

        <!-- Unfiltered files (HTL, CSS, JS, Binary) -->
        <fileSet filtered="false">
            <directory>ui.apps</directory>
            <includes>
                <include>**/*.html</include>
                <include>**/*.js</include>
                <include>**/*.css</include>
                <include>**/*.txt</include>
                <include>**/*.png</include>
                <include>**/*.ico</include>
                <include>**/*.woff</include>
                <include>**/*.woff2</include>
                <include>**/*.ttf</include>
                <include>**/*.otf</include>
                <include>**/*.eot</include>
            </includes>
        </fileSet>
        <fileSet filtered="false">
            <directory>ui.content</directory>
            <includes>
                <include>**/*.png</include>
                <include>**/*.jpg</include>
                <include>**/*.jpeg</include>
                <include>**/*.gif</include>
                <include>**/*.svg</include>
            </includes>
        </fileSet>
        <fileSet filtered="false">
            <directory>ui.frontend</directory>
            <includes>
                <include>**/*</include>
            </includes>
            <excludes>
                <exclude>pom.xml</exclude>
                <exclude>node_modules/**</exclude>
            </excludes>
        </fileSet>
        <fileSet filtered="false">
            <directory>core</directory>
            <includes>
                <include>**/bnd.bnd</include>
            </includes>
        </fileSet>
        <fileSet filtered="false">
            <directory>specs</directory>
            <includes>
                <include>**/*.json</include>
            </includes>
        </fileSet>
        <fileSet filtered="false">
            <directory>bmad</directory>
            <includes>
                <include>**/*.md</include>
                <include>**/*.yaml</include>
                <include>**/*.yml</include>
                <include>**/*.json</include>
                <include>**/*.toml</include>
                <include>**/.gitkeep</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" encoding="UTF-8">
            <directory>bmad/gastown/scripts</directory>
            <includes>
                <include>**/*.sh</include>
            </includes>
        </fileSet>
        <!-- NOT filtered: Velocity treats markdown '##' headings as line comments -->
        <fileSet filtered="false">
            <directory></directory>
            <includes>
                <include>AGENTS.md</include>
            </includes>
        </fileSet>
        <fileSet filtered="false">
            <directory>dispatcher</directory>
            <includes>
                <include>**/*</include>
            </includes>
            <excludes>
                <exclude>pom.xml</exclude>
            </excludes>
        </fileSet>
        <fileSet filtered="true">
            <directory>it.tests</directory>
            <includes>
                <include>**/*</include>
            </includes>
            <excludes>
                <exclude>pom.xml</exclude>
            </excludes>
        </fileSet>
        <fileSet filtered="false">
            <directory>ui.tests</directory>
            <includes>
                <include>**/*</include>
            </includes>
            <excludes>
                <exclude>pom.xml</exclude>
            </excludes>
        </fileSet>
        <fileSet filtered="true">
            <directory>ui.apps.structure</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>ui.apps.structure/src/main/content/META-INF/vault</directory>
            <includes>
                <include>filter.xml</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
